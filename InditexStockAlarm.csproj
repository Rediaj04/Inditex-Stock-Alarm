<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>InditexStockAlarm</AssemblyName>
    <RootNamespace>InditexStockAlarm</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.4.3</Version>
    <Product>Inditex Stock Alarm</Product>
    <Company>Inditex Stock Alarm contributors</Company>
    <Description>Vigila tallas de cualquier ficha de Inditex y avisa con alarma, ventana emergente y pestaña en Brave.</Description>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

</Project>
